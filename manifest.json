{
  "manifest_version": 3,
  "name": "Paperbox",
  "version": "1.7.0",
  "description": "Papertrade queue status and batch orders with queue, pending-tx and OI guards, signed by a session key you authorize.",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://exchange.papertrade.xyz/*"
      ],
      "js": [
        "bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://exchange.papertrade.xyz/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
